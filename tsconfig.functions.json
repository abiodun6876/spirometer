{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": ".netlify/functions-build",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["netlify/functions/**/*.ts"]
}
